SECRET_KEY=gere-uma-chave-longa-e-aleatoria
DEBUG=False
ALLOWED_HOSTS=seuusuario.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=https://seuusuario.pythonanywhere.com
TIME_ZONE=America/Fortaleza
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_PRELOAD=True
MAX_UPLOAD_FILE_SIZE=20971520
MAX_FILES_PER_IMPORT=10
URL_FETCH_MAX_BYTES=3145728
CROSSREF_ENRICH=True
CROSSREF_MAILTO=seu-email@example.com

# SQLite é o padrão e atende a primeira implantação.
# Para migrar ao MySQL do PythonAnywhere, descomente e preencha:
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=seuusuario$citarn
# DB_USER=seuusuario
# DB_PASSWORD=senha-do-banco
# DB_HOST=seuusuario.mysql.pythonanywhere-services.com
# DB_PORT=3306
